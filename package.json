{
  "name": "wire-room-ops",
  "version": "1.0.0",
  "description": "Backend pipeline and admin dashboard for The Wire Room",
  "main": "dist/index.js",
  "scripts": {
    "build:client": "cd client && npm install && npm run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "db:migrate": "ts-node src/scripts/migrate-database.ts",
    "curator-key:mint": "ts-node --transpile-only src/scripts/mint-curator-key.ts",
    "dev": "ts-node src/index.ts",
    "dev:client": "cd client && npm run dev",
    "typecheck": "tsc --noEmit",
    "typecheck:client": "cd client && npm run typecheck",
    "lint": "tsc --noEmit",
    "test": "node --test tests/**/*.test.js",
    "check": "npm run lint && npm run typecheck:client && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "resend": "^4.0.0",
    "twitter-api-v2": "^1.29.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
