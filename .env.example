# Database
DATABASE_URL=postgresql://user:password@host:5432/database
# Set to false to skip SSL cert verification (e.g. local dev)
# DB_SSL_REJECT_UNAUTHORIZED=false

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
GROK_API_KEY=xai-...
FIRECRAWL_API_KEY=fc-...

# Ollama Cloud (cost-effective summarization — can also be set via Settings > API Providers)
# OLLAMA_API_KEY=your-ollama-cloud-api-key
# OLLAMA_DEFAULT_MODEL=gpt-oss:120b

# Summarization provider: 'auto' (Ollama first, Grok fallback), 'ollama', or 'grok'
# SUMMARIZE_PROVIDER=auto

# Email (Resend)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=your@email.com
FROM_EMAIL=noreply@resend.sovereignsignal.com

# Privy Authentication
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
# On Railway, auto-detects from RAILWAY_PUBLIC_DOMAIN if not set
APP_URL=http://localhost:3000

# Optional: Additional emails allowed dashboard access (comma-separated)
# ALLOWED_EMAILS=other@email.com,colleague@email.com

# Optional: Server port (default: 3000)
# PORT=3000

# Optional queue-only LLM score repair on process startup (default: false).
# Enabling this can spend API credits and update up to 500 queued entries.
# STARTUP_LLM_RESCORE_ENABLED=false

# Optional: Override date range for CLI job (ISO format)
# START_DATE=2024-01-01
# END_DATE=2024-01-07

# Distribution (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Forum Scanning (optional)
# FORUM_SCAN_ENABLED=true
# DISCUSS_WATCH_API_URL=https://discuss-dot-watch-production.up.railway.app/api/v1
# FORUM_LOOKBACK_DAYS=2
# FORUM_GRANTS_FEED_ENABLED=true    # pre-classified /api/v1/grants pull (default on; false = kill switch)
# FORUM_GRANTS_MIN_CONFIDENCE=60    # min classifier confidence for feed items

# Brand (for email templates, UI, and AI prompts — customize per deployment)
# BRAND_NAME=The Wire Room
# BRAND_TAGLINE=Intelligence Pipeline
# BRAND_COLOR=#2563eb
# BRAND_URL=https://your-deployment.railway.app
# BRAND_FROM_NAME=The Wire Room
# BRAND_AUDIENCE=grant seekers
# BRAND_CONTENT_TYPE=grant funding opportunities
# BRAND_CONTENT_VERB=apply for

# Perplexity API (for deep web research scans — variant P prompts)
# PERPLEXITY_API_KEY=pplx-...

# Parallel.ai API (for tool_type 'parallel' scan prompts + weekly issue verification)
# PARALLEL_API_KEY=...

# Summary-sync bridge: which wires to bridge from tele-sum summaries (default: crypto,ai,oss)
# SUMMARY_SYNC_WIRES=crypto,ai,oss

# Extra Gate-1 blocked aggregator domains (comma-separated, extends the built-in blocklist)
# SOURCE_BLOCKLIST_EXTRA=example-aggregator.com,another.io

# Program-identity aggregator scrape tier: extra domains for the program-identity aggregator scrape tier (10/day cap)
# PROGRAM_AGGREGATOR_DOMAINS=example-aggregator.org,another.org

# Daily CRM org enrichment (Grok web_search). Default off.
# CRM_ENRICH_ENABLED=true
# Contact discovery writes Needs Review rows. Keep off until that queue is worked.
# CRM_CONTACT_DISCOVERY_ENABLED=true

# Notion page id for the weekly issue Paste Log landing (defaults to the Grant Wires Paste Log)
# WEEKLY_PASTE_LOG_PAGE_ID=...

# Notion Paid Work Leads database id (BD loop writes verified leads here; can also
# live in integration_config as leads_database_id)
# BD_LEADS_DATABASE_ID=...

# Cohort Notion bridge (Cowork + Codex daily scans table → source_runs heartbeat + queue).
# Folded into the daily-digest cycle. Default ON. The enabled Notion integration
# (SimpleCRM) must be granted access to the scans table, or set COHORT_NOTION_TOKEN.
# COHORT_BRIDGE_ENABLED=true
# COHORT_NOTION_DATABASE_ID=366000c0d590805ba2abdd2957ee86a7
# COHORT_NOTION_TOKEN=

# Telegram Intake Bot (optional — for manual URL/article submissions)
# TELEGRAM_INTAKE_BOT_TOKEN=8480696684:AAHU9...
# TELEGRAM_INTAKE_WEBHOOK_SECRET=random-string-for-webhook-validation
# TELEGRAM_INTAKE_ALLOWED_USER_ID=394395765

# Intake wires (comma-separated, fallback if DB has no active feeds)
# INTAKE_WIRES=crypto,ai,oss

# Per-wire keyword overrides for intake wire detection
# INTAKE_WIRE_KEYWORDS_CRYPTO=grant,defi,ethereum,solana,dao
# INTAKE_WIRE_KEYWORDS_AI=llm,model,openai,anthropic,foundation model
# INTAKE_WIRE_KEYWORDS_OSS=open source,github,apache,linux,cncf

# Forum search terms override (comma-separated)
# FORUM_SEARCH_TERMS=grant,funding,rfp,bounty,fellowship

# Quality scorer overrides (JSON arrays or comma-separated)
# QUALITY_FUNDING_TYPES=["grant","fellowship","scholarship","bounty"]
# QUALITY_ACTIONABLE_TYPES=["hackathon","competition","residency"]

# Internal API Keys (agent/programmatic access to /api/scan/* endpoints).
# Each key maps to its own audit-trail identity:
#   INTERNAL_API_KEY            -> agent:stringer   (The Stringer)
#   INTERNAL_API_KEY_DAILY_SCAN -> agent:daily-scan (claude.ai daily-grant-scan routine)
# INTERNAL_API_KEY=your-secret-api-key-here
# INTERNAL_API_KEY_DAILY_SCAN=another-secret-key-here
# Scoped curator keys (Hedwig). JSON array of {id,name,sha256,scopes,expires_at,revoked}.
# Store only the SHA-256 of the bearer. Mint with:
#   npm run curator-key:mint -- --name hedwig --scopes read_queue,decide,propose
# WIRE_ROOM_CURATOR_KEYS=[{"id":"hedwig","name":"Hedwig","sha256":"<64 hex chars>","scopes":["read_queue","decide","propose"],"expires_at":"2027-10-01T00:00:00.000Z","revoked":false}]

# X/Twitter Bearer Token (for engagement metrics collection)
# X_BEARER_TOKEN=AAAA...

# Development mode (set to true to skip auth — NEVER use in production)
# DEV_MODE=true

# Data directory for local file storage
# DATA_DIR=./data

# Watchtower discovery layer (Phase 0) — all default-safe
WATCHTOWER_BUDGET_MONTHLY_USD=20
X_LISTS_ENABLED=false
X_LISTS_DRY_RUN=true
X_LIST_IDS=

# Watchtower registry watch (Phase 1) — all default-safe
# Enable the registry watch lane (rss + html-diff over watch_surfaces)
# Before flipping this on, seed baselines: railway run -- npx ts-node src/scripts/registry-watch-dryrun.ts
# (intake-free; first pass baselines never extract (later dry runs can still extract changed pages), so real runs don't flood the queue with backlog)
REGISTRY_WATCH_ENABLED=false
# Log without submitting to intake
REGISTRY_WATCH_DRY_RUN=true
# Registry watch (Watchtower Phase 1) — which watch_surfaces tiers to poll: "1", "1,2", or "2"
REGISTRY_WATCH_TIERS=1
# Max rss surfaces polled per run
REGISTRY_WATCH_RSS_CAP=60
# Max html_diff surfaces polled per run
REGISTRY_WATCH_DIFF_CAP=80
# Max LLM extractions per run (budget-gated)
REGISTRY_WATCH_EXTRACT_CAP=10

# --- Public snapshot (The Wire Room Live) --------------------------------
# The app PUSHES a narrow ~8KB public projection to a store that serves it
# anonymously; nothing new listens on this service. Leave both blank and the
# publisher no-ops, so this is safe to deploy before the target exists.
SNAPSHOT_PUSH_URL=
SNAPSHOT_PUSH_TOKEN=
# Base URL used to build permalinks for already-published items
SNAPSHOT_TELEGRAM_BASE=https://t.me/thegrantwire
