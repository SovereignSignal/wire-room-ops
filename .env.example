# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
GROK_API_KEY=xai-...
FIRECRAWL_API_KEY=fc-...

# Email (Resend)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=your@email.com
FROM_EMAIL=noreply@cryptograntwire.com

# Magic Link Authentication
MAGIC_LINK_SECRET=your-random-secret-key-here
APP_URL=http://localhost:3000

# Optional: Server port (default: 3000)
# PORT=3000

# Notion CRM Integration (optional)
# NOTION_API_KEY=secret_...
# NOTION_ORGS_DB_ID=your-main-orgs-db-id
# NOTION_OPPS_DB_ID=your-opps-db-id
# NOTION_CRM_PAGE_ID=your-crm-page-id
# NOTION_STAGING_ORGS_DB_ID=your-staging-db-id

# Optional: Override date range for CLI job (ISO format)
# START_DATE=2024-01-01
# END_DATE=2024-01-07

# Telegram Bot Ingestion (optional)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# TELEGRAM_DEFAULT_WIRE=crypto

# Resend Inbound Email Ingestion (optional)
# INBOUND_EMAIL_ADDRESS=grants@inbound.yourdomain.com
# INBOUND_EMAIL_ALLOWED_SENDERS=you@example.com,colleague@example.com
# RESEND_WEBHOOK_SECRET=whsec_...

# Forum Scanning (optional)
# FORUM_SCAN_ENABLED=true
# DISCUSS_WATCH_API_URL=https://discuss-dot-watch-production.up.railway.app/api/v1

# Multi-Channel Distribution (optional)
# DISTRIBUTION_ENABLED=true

# X (Twitter) credentials per wire — OAuth 1.0a User Context
# CRYPTO wire
# X_CRYPTO_API_KEY=your-x-api-key
# X_CRYPTO_API_SECRET=your-x-api-secret
# X_CRYPTO_ACCESS_TOKEN=your-x-access-token
# X_CRYPTO_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# AI wire
# X_AI_API_KEY=your-x-api-key
# X_AI_API_SECRET=your-x-api-secret
# X_AI_ACCESS_TOKEN=your-x-access-token
# X_AI_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# OSS wire
# X_OSS_API_KEY=your-x-api-key
# X_OSS_API_SECRET=your-x-api-secret
# X_OSS_ACCESS_TOKEN=your-x-access-token
# X_OSS_ACCESS_TOKEN_SECRET=your-x-access-token-secret

# Telegram distribution channels per wire (channel ID or @handle)
# TELEGRAM_CHANNEL_CRYPTO=@CryptoGrantWire
# TELEGRAM_CHANNEL_AI=@AIGrantWire
# TELEGRAM_CHANNEL_OSS=@OSSGrantWire
