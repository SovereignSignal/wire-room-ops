# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# API Keys
ANTHROPIC_API_KEY=sk-ant-...
GROK_API_KEY=xai-...
FIRECRAWL_API_KEY=fc-...

# Email (Resend)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=your@email.com
FROM_EMAIL=noreply@cryptograntwire.com

# Magic Link Authentication
MAGIC_LINK_SECRET=your-random-secret-key-here
APP_URL=http://localhost:3000

# Optional: Server port (default: 3000)
# PORT=3000

# Notion CRM Integration (optional)
# NOTION_API_KEY=secret_...
# NOTION_ORGS_DB_ID=301000c0-d590-819f-9619-000bac2ea702
# NOTION_OPPS_DB_ID=301000c0-d590-81fc-9828-000bb5409ede
# NOTION_CRM_PAGE_ID=301000c0d5908049b313f8170819ece3
# NOTION_STAGING_ORGS_DB_ID=your-staging-db-id-here

# Optional: Override date range for CLI job (ISO format)
# START_DATE=2024-01-01
# END_DATE=2024-01-07
